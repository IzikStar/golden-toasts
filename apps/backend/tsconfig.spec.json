{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/jest",
    "module": "commonjs",
    "moduleResolution": "node10",
    "customConditions": null,
    "types": ["jest", "node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": [
    "jest.config.ts",
    "jest.e2e.config.ts",
    "src/**/*.ts",
    "e2e/**/*.ts"
  ]
}
