# Copy to apps/backend/.env (Nx loads it automatically when running backend targets)

# HTTP port the API listens on (served under /api)
PORT=3078

# Secret used to sign and verify JWTs.
# REQUIRED when NODE_ENV=production: a private random value of 32+ characters,
# e.g. `openssl rand -hex 32`. The server refuses to start without one.
# In development a fixed insecure fallback is used if this is empty.
JWT_SECRET=

# PostgreSQL connection (defaults shown)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=toastsDB
